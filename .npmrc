# Do not run install scripts (preinstall, install, postinstall). A compromised package most
# often attacks through these, and npm install runs on the same machine as your signed-in
# Chrome profile. This also skips this project's own lifecycle hooks, so do not add any.
ignore-scripts=true

# esbuild ships its binary as a platform-specific optional dependency. Without install scripts
# it cannot download a missing binary, so optional dependencies must always be installed, even
# for anyone with omit=optional in their own npm config.
include=optional

{
  "manifest_version": 3,
  "name": "Overtake: agent Spaces for Chrome",
  "short_name": "Overtake",
  "version": "0.1.0",
  "description": "Agent Spaces in your own Chrome: full CDP automation for AI agents, with explicit human/agent control hand-off.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "nativeMessaging", "scripting", "webNavigation", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": { "default_title": "Open Spaces", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-control": { "suggested_key": { "default": "Alt+Shift+E" }, "description": "Take over / give back the current agent Space" },
    "open-overview": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open the Spaces overview" }
  }
}
